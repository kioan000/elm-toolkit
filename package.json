{
  "author": "kioan000",
  "description": "Monorepo workspace for some utilities around elm tooling",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">= 24.15.0 < 25",
    "npm": ">= 11.4.1 <12"
  },
  "name": "elm-toolkit",
  "packageManager": "yarn@4.3.1",
  "private": true,
  "scripts": {
    "build": "yarn workspaces foreach -A -t run build",
    "clean": "yarn workspaces foreach -A run clean",
    "postinstall": "yarn build",
    "test": "yarn workspaces foreach -A run test"
  },
  "version": "0.0.1",
  "workspaces": [
    "workspaces/*"
  ]
}
