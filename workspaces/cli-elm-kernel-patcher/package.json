{
  "author": "kioan000",
  "type": "module",
  "name": "@elm-toolkit/cli-elm-kernel-patcher",
  "version": "0.1.0-alpha.1",
  "description": "CLI script for patch elm library",
  "license": "BSD-3-Clause",
  "main": "./dist/command.js",
  "types": "./dist/command.d.ts",
  "exports": {
    ".": {
      "types": "./dist/command.d.ts",
      "default": "./dist/command.js"
    },
    "./patcher": {
      "types": "./dist/lib/patcher.d.ts",
      "default": "./dist/lib/patcher.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "./dist/command.js",
  "files": [
    "dist",
    "command.ts",
    "lib/patcher.ts",
    "lib/patches.tar.gz",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">= 24.15.0 < 25",
    "npm": ">= 11.4.1 <12"
  },
  "scripts": {
    "build": "tsc -b && cp lib/patches.tar.gz dist/lib/patches.tar.gz",
    "clean": "tsc -b --clean",
    "dev": "node command.ts",
    "prepare": "yarn build"
  },
  "dependencies": {
    "@elm-toolkit/cli-lib": "workspace:^",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
